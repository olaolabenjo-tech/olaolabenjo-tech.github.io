---
/* #samples — evaluation pack request. */
import { EVALUATION_PACK_MAILTO } from '../../config/contact';
---

<section id="samples" class="wrap">
  <div class="eyebrow">Samples</div>
  <h2>Request an evaluation pack.</h2>
  <div class="sample-box">
    <p>
      Our controlled speech evaluation pack includes representative audio in
      Nigerian-accented English and Yorùbá, <strong>matching time-aligned transcripts</strong>,
      and a <strong>specimen contributor consent form</strong>. Request it by email so we can
      understand your intended use and share the appropriate materials for technical and
      compliance review. Image and video specifications are prepared per commission.
    </p>
    <a
      class="btn btn-primary"
      href={EVALUATION_PACK_MAILTO}
      aria-label="Request an evaluation pack by email — opens your email application"
    >Request an evaluation pack by email</a>
  </div>
</section>
