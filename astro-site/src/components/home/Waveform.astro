---
/* Decorative audio waveform separating the hero from the page body. */
const BARS = [
  30, 55, 80, 45, 95, 60, 35, 75, 50, 88, 40, 65, 92, 38, 70, 52, 84, 44, 96, 58,
  33, 78, 48, 86, 42, 68, 90, 36, 74, 56, 82, 46, 94, 54, 31, 72, 49, 87, 41, 63,
];
---

<div class="wrap wave" aria-hidden="true">
  {BARS.map((height) => <i style={`height:${height}%`}></i>)}
</div>

<style>
  .wave { display: flex; align-items: flex-end; gap: 3px; height: 44px; overflow: hidden }
  .wave i { flex: 1; background: var(--green); opacity: .85; border-radius: 2px 2px 0 0; min-width: 2px }
  .wave i:nth-child(4n) { background: var(--amber) }
  .wave i:nth-child(6n) { opacity: .35 }
</style>
