---
/* #contact — email-led dataset brief. */
import ContactDirect from '../ContactDirect.astro';

const MAILTO = 'mailto:dataservices@bsgdataworks.com?subject=Dataset%20brief&body=Hello%20BSG%20DataWorks%2C%0A%0A-%20Dataset%20type%20and%20intended%20model%20use%3A%0A-%20Languages%2C%20markets%2C%20or%20participant%20profile%3A%0A-%20Target%20volume%20and%20preferred%20format%3A%0A-%20Desired%20delivery%20timeline%3A%0A-%20Rights%2C%20governance%2C%20or%20compliance%20requirements%3A%0A-%20Approximate%20pilot%20budget%20or%20licensing%20range%2C%20if%20known%3A%0A%0AThanks%2C%0A';

const CHECKLIST = [
  'Dataset type and intended model use',
  'Languages, markets, or participant profile',
  'Target volume and preferred format',
  'Desired delivery timeline',
  'Rights, governance, or compliance requirements',
  'Approximate pilot budget or licensing range, if known — under US$5k, US$5k–50k, or US$50k+',
];
---

<section class="wrap" id="contact">
  <div class="contact-band">
    <h2>Start a dataset brief by email</h2>
    <p class="contact-intro">
      Share a few project details and we will reply within 48 hours with initial scoping
      questions, a likely timeline, and the next step.
    </p>

    <div class="brief-checklist">
      <p class="brief-checklist-title">What helps us get started</p>
      <ul>
        {CHECKLIST.map((item) => <li>{item}</li>)}
      </ul>
      <p class="brief-reassurance">
        <em>
          If you do not have all of this yet, send what you have — including if you are still
          scoping the budget. We will fill in the rest on a call.
        </em>
      </p>
    </div>

    <ContactDirect />

    <a
      class="btn"
      href={MAILTO}
      aria-label="Start a dataset brief by email — opens your email application"
    >Start a dataset brief by email</a>
  </div>
</section>

<style>
  .contact-band {
    background: var(--green);
    color: #fff;
    border-radius: 14px;
    padding: 44px 40px;
    text-align: center;
  }
  .contact-band h2 { color: #fff }
  .contact-band .btn { background: #fff; color: var(--green-deep) }

  .contact-intro { margin: 10px auto 20px; max-width: 600px }

  .brief-checklist {
    max-width: 610px;
    margin: 0 auto 22px;
    padding: 18px 22px;
    text-align: left;
    background: rgba(255, 255, 255, .10);
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 10px;
  }
  .brief-checklist-title {
    margin: 0 0 9px;
    color: #fff;
    font-family: var(--mono);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .brief-checklist ul { margin: 0; padding-left: 20px }
  .brief-checklist li { margin: 5px 0; color: #F5FAF6; font-size: .94rem; line-height: 1.45 }
  .brief-reassurance { margin: 14px 0 0; color: #EAF2EC; font-size: .9rem; line-height: 1.5 }

  @media (max-width: 640px) {
    .brief-checklist { padding: 16px 18px }
  }
</style>
