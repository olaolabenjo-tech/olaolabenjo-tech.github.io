---
import type { NavLink, SystemVariant } from '../types';

interface Props {
  /** Nav links differ per page; each page passes its own set. */
  links?: NavLink[];
  homeHref?: string;
  /** Each design system styles the nav differently. */
  variant?: SystemVariant;
}

const { links = [], homeHref = '/', variant = 'service' } = Astro.props;
---

<nav class={variant} aria-label="Primary navigation">
  <div class:list={['nav-inner', variant === 'service' && 'wrap']}>
    <a class="logo" href={homeHref} aria-label="BSG DataWorks home">
      <img class="logo-image" src="/assets/images/bsg-dataworks-logo.png" alt="" />
    </a>
    {links.length > 0 && (
      <div class={variant === 'policy' ? 'nav-actions' : 'nav-links'}>
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    )}
  </div>
</nav>

<style>
  nav { position: sticky; top: 0; border-bottom: 1px solid var(--line) }

  /*
    The approved logo lock-up. The originals kept a text fallback rule that
    every page then overrode with `!important`; all 13 render the image, so
    the dead rule is dropped rather than carried forward.
  */
  .logo { display: inline-flex; align-items: center; line-height: 1; flex: 0 0 auto }
  .logo:hover { text-decoration: none }
  .logo-image {
    display: block;
    width: 188px;
    height: 61px;
    object-fit: contain;
    object-position: left center;
  }

  .nav-inner { display: flex; align-items: center; justify-content: space-between }
  .nav-links, .nav-actions { display: flex; align-items: center }
  .nav-links a { color: var(--ink) }

  /* ── Service pages ────────────────────────────────────────────────── */
  nav.service {
    z-index: 30;
    background: rgba(251, 250, 247, .96);
    backdrop-filter: blur(8px);
  }
  nav.service .nav-inner { gap: 22px; min-height: 68px }
  nav.service .nav-links { gap: 18px; font-size: .88rem; font-weight: 500 }
  nav.service .nav-links a:last-child { color: var(--green); font-weight: 700 }

  @media (max-width: 800px) {
    nav.service .nav-links { display: none }
  }

  /* ── Homepage ─────────────────────────────────────────────────────── */
  nav.home { z-index: 50; background: var(--paper) }
  nav.home .nav-inner { padding: 14px 24px; max-width: 1080px; margin: 0 auto }
  nav.home .nav-links { gap: 20px; font-size: .9rem; font-weight: 500 }
  nav.home .nav-links a:hover { color: var(--green); text-decoration: none }

  @media (max-width: 860px) {
    nav.home .nav-links { display: none }
  }

  /* ── Policy pages ─────────────────────────────────────────────────── */
  nav.policy {
    z-index: 30;
    background: rgba(251, 250, 247, .96);
    backdrop-filter: blur(8px);
  }
  nav.policy .nav-inner { gap: 20px; min-height: 68px }
  nav.policy .nav-actions { gap: 18px; font-weight: 600; font-size: .9rem }
  nav.policy .nav-actions a:last-child {
    display: inline-flex;
    padding: 9px 13px;
    border: 1px solid var(--green);
    border-radius: 6px;
  }

  @media (max-width: 560px) {
    nav.policy .nav-actions a:first-child { display: none }
  }

  /* ── Both ─────────────────────────────────────────────────────────── */
  @media (max-width: 560px) {
    .nav-inner { padding-top: 8px; padding-bottom: 8px }
    .logo-image { width: 158px; height: 52px }
  }
</style>
