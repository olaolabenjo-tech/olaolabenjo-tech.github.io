---
/* Direct email and WhatsApp contact route. Used inside the dark contact band. */
---

<div class="contact-direct" aria-label="Direct contact options">
  <p>
    <strong>Prefer to write directly?</strong>
    <a href="mailto:dataservices@bsgdataworks.com">dataservices@bsgdataworks.com</a>
  </p>
  <p>
    <strong>WhatsApp only:</strong>
    <a
      href="https://wa.me/2348067904903"
      target="_blank"
      rel="noopener"
      aria-label="Message BSG DataWorks on WhatsApp — opens WhatsApp"
    >+234 806 790 4903</a>
  </p>
</div>

<style>
  .contact-direct {
    margin: 18px 0;
    padding: 14px 16px;
    border: 1px solid rgba(255, 255, 255, .42);
    border-radius: 10px;
    background: rgba(255, 255, 255, .08);
    max-width: 720px;
  }
  .contact-direct p { margin: 0; color: #fff; font-size: .95rem; line-height: 1.55 }
  .contact-direct p + p { margin-top: 4px }
  .contact-direct a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
</style>
