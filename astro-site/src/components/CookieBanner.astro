<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description cookie-current-choice"
  hidden
>
  <div class="cookie-text">
    <h2 id="cookie-title">Your privacy choices</h2>
    <p id="cookie-description">
      We use optional Google Analytics to understand how visitors use this
      website. Analytics will not load unless you choose <strong
        >Accept analytics</strong
      >. Your choice is saved locally in your browser (using <code
        >localStorage</code
      >) so we do not ask again on future visits. You can change your choice at
      any time through Cookie settings. Read our <a href="/privacy-policy"
        >Privacy Policy</a
      >.
    </p>
    <p
      id="cookie-current-choice"
      class="cookie-current-choice"
      role="status"
      aria-live="polite"
    >
    </p>
  </div>
  <div class="cookie-actions">
    <button
      id="cookie-accept"
      type="button"
      class="cookie-choice"
      onclick="bsgSetAnalyticsConsent('granted')"
      aria-pressed="false">Accept analytics</button
    >
    <button
      id="cookie-decline"
      type="button"
      class="cookie-choice"
      onclick="bsgSetAnalyticsConsent('denied')"
      aria-pressed="false">Decline</button
    >
    <button
      id="cookie-defer"
      type="button"
      class="cookie-defer"
      onclick="bsgDeferCookieChoice()"
      aria-label="Close this notice without saving a choice; Google Analytics will remain off until you decide"
      >Not now</button
    >
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px 32px;
    /* The bar's content keeps the site's shell measure. */
    padding: 16px max(var(--shell-pad), calc((100% - var(--shell-max)) / 2));
    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    /* Light, so it stands out over the dark hero and footer as well as the
       light pages; the green top rule and shadow lift it off light pages. */
    background: #ffffff;
    color: var(--ink);
    border-top: 3px solid var(--green);
    box-shadow: 0 -12px 34px rgba(4, 19, 31, 0.28);
  }
  .cookie-banner[hidden] {
    display: none;
  }
  .cookie-banner h2 {
    font-family: var(--sans);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .cookie-banner p {
    color: var(--slate);
    font-size: 0.86rem;
    line-height: 1.5;
    max-width: 820px;
  }
  .cookie-banner a {
    color: var(--green-deep);
    font-weight: 600;
    text-decoration: underline;
  }
  .cookie-banner code {
    font-size: 0.82rem;
  }

  .cookie-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cookie-choice {
    min-height: 44px;
    border: 1.5px solid var(--green);
    border-radius: 6px;
    padding: 0 18px;
    background: #fff;
    color: var(--green-deep);
    font:
      600 0.92rem "IBM Plex Sans",
      sans-serif;
    white-space: nowrap;
    cursor: pointer;
  }
  /* Accept is the filled one; Decline is outlined. Both are equally easy
     to choose, so neither is hidden or downplayed. */
  #cookie-accept {
    background: var(--green);
    color: #fff;
  }
  .cookie-choice:hover {
    background: var(--mist);
    color: var(--green-deep);
  }
  #cookie-accept:hover {
    background: var(--green-deep);
    color: #fff;
  }
  .cookie-choice:focus-visible {
    outline: 3px solid var(--green-deep);
    outline-offset: 3px;
  }
  .cookie-choice[aria-pressed="true"] {
    box-shadow: inset 0 0 0 2px var(--green-deep);
  }

  .cookie-defer {
    min-height: 44px;
    background: none;
    border: 0;
    color: var(--slate);
    font:
      500 0.88rem "IBM Plex Sans",
      sans-serif;
    white-space: nowrap;
    cursor: pointer;
    padding: 0 8px;
    text-decoration: underline;
  }
  .cookie-defer:hover {
    color: var(--ink);
  }
  .cookie-defer:focus-visible {
    color: var(--ink);
    outline: 2px solid var(--green-deep);
    outline-offset: 3px;
  }

  .cookie-current-choice {
    margin-top: 4px;
    color: var(--ink);
    font-weight: 600;
  }
  .cookie-current-choice:empty {
    display: none;
  }

  /* Tablet and phone: text above, buttons below. */
  @media (max-width: 900px) {
    .cookie-banner {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 560px) {
    .cookie-banner {
      padding-top: 14px;
    }
    .cookie-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .cookie-choice {
      width: 100%;
      padding: 0 10px;
    }
    .cookie-defer {
      grid-column: 1 / -1;
    }
  }
</style>
