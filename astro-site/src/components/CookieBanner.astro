---
/*
  Markup is carried over verbatim from the originals, including the ids and
  the inline onclick handlers, because ConsentScript.astro drives this dialog
  by id and exposes its handlers as globals. Both must change together.
*/
---

<div
  id="cookie-banner"
  class="cookie-banner"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-description cookie-current-choice"
  hidden
>
  <h2 id="cookie-title">Your privacy choices</h2>
  <p id="cookie-description">
    We use optional Google Analytics to understand how visitors use this website. Analytics
    will not load unless you choose <strong>Accept analytics</strong>. Your choice is saved
    locally in your browser (using <code>localStorage</code>) so we do not ask again on future
    visits. You can change your choice at any time through Cookie settings. Read our
    <a href="/privacy-policy">Privacy Policy</a>.
  </p>
  <p id="cookie-current-choice" class="cookie-current-choice" role="status" aria-live="polite"></p>
  <div class="cookie-actions">
    <button
      id="cookie-accept"
      type="button"
      class="cookie-choice"
      onclick="bsgSetAnalyticsConsent('granted')"
      aria-pressed="false"
    >Accept analytics</button>
    <button
      id="cookie-decline"
      type="button"
      class="cookie-choice"
      onclick="bsgSetAnalyticsConsent('denied')"
      aria-pressed="false"
    >Decline</button>
    <button
      id="cookie-defer"
      type="button"
      class="cookie-defer"
      onclick="bsgDeferCookieChoice()"
      aria-label="Close this notice without saving a choice; Google Analytics will remain off until you decide"
    >Not now</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 18px;
    right: 18px;
    bottom: 18px;
    z-index: 100;
    max-width: 760px;
    margin: 0 auto;
    padding: 22px;
    background: #14231C;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 14px;
    box-shadow: 0 18px 45px rgba(20, 35, 28, .28);
  }
  .cookie-banner[hidden] { display: none }
  .cookie-banner h2 { font-size: 1.35rem; color: #fff; margin-bottom: 8px }
  .cookie-banner p { color: #EAF2EC; font-size: .93rem; line-height: 1.55 }
  .cookie-banner a { color: #fff; text-decoration: underline }

  .cookie-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px }

  .cookie-choice {
    min-width: 160px;
    border: 1px solid #fff;
    border-radius: 6px;
    padding: 11px 16px;
    background: #fff;
    color: #0A4A2C;
    font: 600 .94rem 'IBM Plex Sans', sans-serif;
    cursor: pointer;
  }
  .cookie-choice:hover,
  .cookie-choice:focus-visible { outline: 3px solid #C98A1B; outline-offset: 3px }
  .cookie-choice[aria-pressed="true"] {
    background: #EAF2EC;
    border-color: #EAF2EC;
    box-shadow: inset 0 0 0 2px #0A4A2C;
  }

  .cookie-defer {
    background: none;
    border: 0;
    color: #EAF2EC;
    font: 500 .88rem 'IBM Plex Sans', sans-serif;
    cursor: pointer;
    padding: 11px 8px;
    text-decoration: underline;
    align-self: center;
  }
  .cookie-defer:hover,
  .cookie-defer:focus-visible { color: #fff; outline: 2px solid #C98A1B; outline-offset: 3px }

  .cookie-current-choice { margin-top: 12px; color: #EAF2EC; font-weight: 600 }

  @media (max-width: 560px) {
    .cookie-choice { width: 100% }
  }
</style>
