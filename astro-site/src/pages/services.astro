---
/*
  Services hub — the "service directory" layout.

  Five equal cards, one per service, plus a sixth tile linking to language
  coverage. Copy is carried over from what the site already published;
  nothing about capability was invented.

  Collection, annotation and compliance have dedicated pages on the old site
  that are not ported yet; add a link to each card as its page lands (see
  config/footer.ts PENDING).
*/
import ServiceLayout from '../layouts/ServiceLayout.astro';
import { ENQUIRY_LABEL, ENQUIRY_URL } from '../config/contact';

const SERVICES = [
  {
    tag: '01 · Build',
    title: 'Commissioned data collection',
    body: 'You specify languages, domains, demographics, devices, and volume. We recruit, obtain consent, collect, and QA — then deliver to your format.',
  },
  {
    tag: '02 · Improve',
    title: 'Annotation & labelling',
    body: 'Full-service annotation on your existing data or ours, by trained native speakers.',
    items: [
      'Transcription and time-alignment',
      'Classification and categorisation',
      'Segmentation and diarisation',
      'Entity and sentiment labelling',
      'Image and video tagging to your schema',
    ],
  },
  {
    tag: '03 · Clear',
    title: 'Data strategy & compliance consultancy',
    body: 'Advisory from a practitioner who runs collection operations daily.',
    items: [
      'Data acquisition strategy for African markets',
      'NDPA 2023 / NDPC compliance for data collection',
      'Consent framework and documentation design',
      'Vendor and dataset due diligence',
      'African language technology advisory',
    ],
  },
  {
    tag: '04 · Ready-made',
    title: 'Corpus licensing',
    body: 'Ready-built datasets licensed commercially — exclusive or non-exclusive — with full documentation and consent audit trail.',
  },
  {
    tag: '05 · Language',
    title: 'Translation & localisation',
    body: 'Professional language services across Nigerian languages, English, French, and German, backed by two decades of linguist-network management.',
  },
];


const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'African AI Training Data Services',
  description:
    'Commissioned African data collection, annotation and labelling, data strategy and compliance consultancy, corpus licensing, and translation and localisation for AI training data projects.',
  provider: { '@type': 'Organization', name: 'BSG DataWorks', url: 'https://bsgdataworks.com/' },
  areaServed: [
    { '@type': 'Country', name: 'Nigeria' },
    { '@type': 'Place', name: 'West Africa' },
  ],
  serviceType: 'AI training data collection, annotation, licensing and consultancy',
};
---

<ServiceLayout
  title="Services | BSG DataWorks"
  description="African AI training data services: commissioned data collection, annotation and labelling, data strategy and compliance consultancy, corpus licensing, and translation and localisation."
  canonicalPath="/services"
  ogDescription="Commissioned collection, annotation and labelling, compliance consultancy, corpus licensing, and translation across Nigerian and West African languages."
  twitterTitle="Services | BSG DataWorks"
  twitterDescription="Data collection, annotation, compliance consultancy, licensing and translation for African AI training data."
  schema={schema}
>
  <header class="hero">
    <div class="wrap">
      <p class="eyebrow">Services · Nigeria &amp; West Africa</p>
      <h1>Data built, made usable, or <em>cleared for use</em>.</h1>
      <p class="hero-copy">
        We work with teams at every stage: those who need data built from scratch, those who
        already have data and need it made usable, and those who need to know whether their
        African data strategy will survive a compliance review.
      </p>
      <a class="btn btn-primary hero-cta" href={ENQUIRY_URL}>{ENQUIRY_LABEL}</a>
    </div>
  </header>

  <section id="services" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Five services</p>
        <h2 id="services-heading">Pick the one that fits your starting point.</h2>
      </div>

      <div class="svc-grid">
        {SERVICES.map((service) => (
          <article class="svc">
            <p class="svc-tag">{service.tag}</p>
            <h3>{service.title}</h3>
            <p>{service.body}</p>
            {service.items && (
              <ul class="svc-list">
                {service.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </article>
        ))}
        <a class="svc svc-languages" href="/language-coverage">
          <p class="svc-tag">Languages</p>
          <h3>Coverage by language</h3>
          <p>What you can evaluate now, what is being collected, and what we build to your specification.</p>
          <span class="svc-more">See language coverage <span aria-hidden="true">→</span></span>
        </a>
      </div>

    </div>
  </section>
</ServiceLayout>

<style>
  /* Single-column hero: the old side panel only listed the five services,
     which now sit directly below. */
  .hero h1 { max-width: 820px }

  #services { padding-top: 64px }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--card-gap);
  }

  .svc {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 28px;
  }
  .svc h3 { font-size: 1.35rem; margin: 0 }
  .svc p { margin: 0; color: #3C4A42 }

  .svc-tag {
    font-family: var(--mono);
    font-size: .8rem;
    font-weight: 600;
    color: var(--amber-text) !important;
  }

  .svc-list { margin: 0; padding-left: 18px; font-size: .92rem; color: #3C4A42 }
  .svc-list li { margin: 3px 0 }
  .svc-list li::marker { color: var(--green) }


  /* The sixth tile fills the grid's last slot and links to language coverage. */
  .svc-languages { background: var(--mist); border-color: #BFD0C2; color: inherit; text-decoration: none }
  .svc-languages:hover { border-color: var(--green); text-decoration: none }
  .svc-languages:hover h3 { text-decoration: underline; text-underline-offset: 4px }
  .svc-more { margin-top: auto; padding-top: 14px; font-weight: 700; color: var(--green-deep) }

  @media (max-width: 560px) {
    .svc-grid { grid-template-columns: 1fr }
    .svc { padding: 22px }
  }
</style>
